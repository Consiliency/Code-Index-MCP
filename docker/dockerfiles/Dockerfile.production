# Multi-stage production Dockerfile for MCP Server
FROM python:3.12-slim AS builder
ARG DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

# Install system dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create build directory
WORKDIR /build
ENV UV_PROJECT_ENVIRONMENT=/home/mcp/.venv

# Copy dependency metadata first for better caching
COPY pyproject.toml uv.lock README.md ./
COPY mcp_server/ ./mcp_server/
COPY baml_sdk/ ./baml_sdk/

# Install Python dependencies and the project entry points
RUN mkdir -p /home/mcp && \
    pip install --no-cache-dir uv && \
    uv sync --locked --extra production --no-editable

# tree-sitter-language-pack 1.20 downloads grammars on first use. Prefetch every
# registry grammar at build time so the image never downloads at runtime
# (Consiliency/Code-Index-MCP#115). The pack writes a private (0700) cache, so
# make it world-readable; the archive bundles are not needed once extracted.
ENV TREE_SITTER_LANGUAGE_PACK_CACHE_DIR=/opt/tree-sitter-language-pack
RUN /home/mcp/.venv/bin/mcp-index grammars prefetch && \
    rm -rf /opt/tree-sitter-language-pack/tree-sitter-language-pack/*/bundles && \
    chmod -R a+rX /opt/tree-sitter-language-pack

# Production stage
FROM python:3.12-slim AS production
ARG DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies including tree-sitter requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd -r mcp && useradd -r -g mcp -d /app -s /bin/bash mcp

# Set up application directory
WORKDIR /app

# Copy Python dependencies and the prefetched, read-only grammar cache
COPY --from=builder /home/mcp/.venv /home/mcp/.venv
COPY --from=builder /opt/tree-sitter-language-pack /opt/tree-sitter-language-pack
ENV TREE_SITTER_LANGUAGE_PACK_CACHE_DIR=/opt/tree-sitter-language-pack

# Make sure virtualenv scripts are usable
ENV PATH=/home/mcp/.venv/bin:$PATH

# Create necessary directories
RUN mkdir -p /var/log/mcp-server /app/uploads /app/data \
    && chown -R mcp:mcp /app /var/log/mcp-server

# Switch to non-root user
USER mcp

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV MCP_ENVIRONMENT=production
ENV SEMANTIC_SEARCH_ENABLED=false
ENV SEMANTIC_DEFAULT_PROFILE=legacy-default

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose ports
EXPOSE 8000 8001

# Production startup command with Gunicorn
CMD ["gunicorn", "mcp_server.gateway:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--forwarded-allow-ips", "", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "1", \
     "--worker-connections", "1000", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100", \
     "--timeout", "30", \
     "--keep-alive", "2", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info"]
